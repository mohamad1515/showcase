  "home2_sections": [
    {
      "id": "hero",
      "layout": "large promotional hero",
      "surface": "dark image",
      "radius": "md",
      "content": "high-contrast uppercase headline + CTA",
      "notes": "Product packshots occupy the visual focus; keep text area uncluttered."
    },
    {
      "id": "promo-grid",
      "layout": "two compact promotional cards",
      "gap": "16px-24px",
      "radius": "md"
    },
    {
      "id": "shop-by-goals",
      "layout": "horizontal goal cards",
      "card_radius": "md",
      "image_ratio": "approximately 1:1",
      "notes": "Goal discovery is a major Home 2 navigation pattern."
    },
    {
      "id": "best-sellers",
      "layout": "product grid with dark promotional tile",
      "columns": 4,
      "notes": "Promotional tile visually anchors the product grid."
    },
    {
      "id": "trending-now",
      "layout": "product section with strong promotional imagery",
      "notes": "Use a distinct campaign background without overpowering product cards."
    },
    {
      "id": "service-strip",
      "layout": "full-width accent strip",
      "surface": "#7DFF2A",
      "text": "#111111"
    },
    {
      "id": "exceptional-service",
      "layout": "split editorial image + text",
      "surface": "#F6F6F6",
      "radius": "md"
    },
    {
      "id": "top-picks",
      "layout": "product grid + featured visual",
      "columns": 4
    },
    {
      "id": "customer-love",
      "layout": "dark testimonial section",
      "surface": "#171717",
      "text": "#FFFFFF",
      "radius": "md"
    },
    {
      "id": "articles",
      "layout": "3 article cards",
      "card_radius": "md"
    },
    {
      "id": "community",
      "layout": "horizontal social image strip",
      "notes": "Use consistent square crops."
    },
    {
      "id": "footer",
      "layout": "dark multi-column footer",
      "surface": "#171717",
      "text": "#FFFFFF"
    }
  ],
  "interaction": {
    "product_hover": {
      "transform": "translateY(-4px)",
      "duration": "180ms",
      "easing": "ease-out"
    },
    "button_hover": {
      "duration": "160ms",
      "easing": "ease-out"
    },
    "link_transition": "150ms ease"
  },
  "responsive_rules": {
    "hero": "stack or crop intelligently; preserve headline readability",
    "promo_grid": "2 columns desktop/tablet, 1 column mobile",
    "goal_cards": "horizontal scroll/carousel on mobile",
    "product_grid": "4 -> 3 -> 2 columns",
    "footer": "4+ columns desktop -> 2 tablet -> stacked mobile",
    "navigation": "desktop menu -> mobile drawer"
  },
  "page_inventory": {
